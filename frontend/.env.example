# Values baked into the client bundle at build time (see frontend/Dockerfile).
# Anything not prefixed NEXT_PUBLIC_ stays on the server and never reaches the
# browser — keep internal hostnames there.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Shared Better Auth service (https://auth.shrijit.tech)
NEXT_PUBLIC_AUTH_URL=https://auth.shrijit.tech
# Absolute origin used for canonical tags, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only ───────────────────────────────────────────────────────────
# Every variable below is read through src/server/env.ts, which is the only
# place in the app that touches process.env. Each one lists what the app does
# without it: nothing here is required except MONGO_URI, and the app boots
# degraded rather than crashing.

# Required. Without it nothing can be saved and /api/health cannot answer.
MONGO_URI=mongodb://localhost:27017/triptribe

# ── Grounded itinerary pipeline ────────────────────────────────────────────
# Places powers candidate discovery and enrichment; Routes orders each day and
# reports real travel time.
#
# SKU note: `rating`, `priceLevel` and `regularOpeningHours` are Enterprise-tier
# on every Places endpoint — there is no cheaper tier that returns them — and
# the free allowance is 1,000 calls/month. Enrich only the solver's shortlist,
# and see src/server/domain/places/quota.ts for the budget that enforces it.
# Without this key the solver returns PLACES_NOT_CONFIGURED (503).
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Without this key travel times fall back to the geodesic estimate in
# domain/solver/geo.ts — slower days, same plan shape.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here
# Without this key city hero images fall back to a placeholder.
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_custom_search_api_key_here

# Optional: an OpenAI-compatible endpoint for the narrator.
# Without OPENAI_KEY the narrator is skipped and places keep their factual
# Google descriptions — a plainer plan, never a broken one.
OPENAI_KEY=your_openai_compatible_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-lite-001
# NARRATOR_MODEL=google/gemini-2.0-flash-lite-001

# Shared Better Auth, read server-side to resolve the session cookie.
AUTH_URL=https://auth.shrijit.tech

# Email hand-off. Without RESEND_API_KEY the "send this plan" control explains
# itself instead of failing.
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=TripTribe <plans@triptribe.shrijit.tech>

# Optional request deadlines, in milliseconds.
# PLACES_TIMEOUT_MS=15000
# ROUTES_TIMEOUT_MS=20000

# Set by the deploy pipeline to the commit SHA; /api/health reports it so the
# gate can tell one deployed build from another.
# APP_VERSION=unknown