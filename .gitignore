# frontend\node_modules

# backend/node_modules
# backend/.env
# frontend\.env
# frontend/.env

frontend/.env
frontend/node_modules/
backend/.env
backend/node_modules/

# Impeccable tool state: review screenshots, surface dumps, question rolls.
# Local tooling only — nothing in the app or CI reads it.
.impeccable/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
__pycache__/

# dotenvx private keys — stored in GitHub Actions, never committed
.env.keys

# dotenvx-encrypted env — safe to commit; private key lives in GitHub Actions
!.env.production
